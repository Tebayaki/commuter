AMAP_KEY=
SERVERCHAN_KEY=

# Required coordinates use longitude,latitude format.
HOME_POINT=
WORK_POINT=

# Optional waypoint coordinates; separate multiple points with semicolons.
HOME_TO_WORK_WAYPOINTS_A=
HOME_TO_WORK_WAYPOINTS_B=
WORK_TO_HOME_WAYPOINTS_A=
WORK_TO_HOME_WAYPOINTS_B=

# Required daily schedule times, in 24-hour HH:MM format.
WORK_TIME=
HOME_TIME=

# Time zone used by the scheduler.
TIMEZONE=Asia/Shanghai
