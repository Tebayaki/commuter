AMAP_KEY=
SERVERCHAN_KEY=

# Each point accepts longitude,latitude or an address; prefix address with
# city@ to narrow geocoding results (e.g. Beijing@Chaoyang District).
HOME_POINT=
WORK_POINT=

# Route waypoints accept coordinates or city@address; separate multiple with semicolons.
HOME_TO_WORK_WAYPOINTS_A=
HOME_TO_WORK_WAYPOINTS_B=
WORK_TO_HOME_WAYPOINTS_A=
WORK_TO_HOME_WAYPOINTS_B=

# Required daily schedule times, in 24-hour HH:MM format.
WORK_TIME=09:00
HOME_TIME=17:00

# Comma-separated weekdays: 1=Monday, 2=Tuesday, ..., 7=Sunday.
# Monday through Friday:
WORKDAYS=1,2,3,4,5

# Time zone used by the scheduler.
TIMEZONE=Asia/Shanghai
